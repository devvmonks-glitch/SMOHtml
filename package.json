{
  "name": "smohtml",
  "version": "0.4.0",
  "private": true,
  "description": "Super Mario Odyssey-style movement prototype and dev room in three.js",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --minify --sourcemap --outfile=game.js --loader:.glb=binary && node tools/build-single.mjs",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=game.js --loader:.glb=binary --watch",
    "single": "node tools/build-single.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
